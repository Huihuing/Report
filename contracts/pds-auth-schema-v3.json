{
  "name": "pds-auth-schema-v3",
  "schema_version": 3,
  "T06_frozen_source_commit": "bb0352766c2b3974b074c3ec2db261679b49f7a7",
  "timezone": "Asia/Seoul",
  "auth": {
    "provider": "Supabase Auth",
    "sdk_version": "@supabase/supabase-js@2.95.0",
    "password_hash": "bcrypt with per-account salt",
    "identity": "email",
    "server_session": "256-bit opaque bearer stored as SHA-256 digest",
    "expiry_minutes": 60,
    "logout": "immediate DB session delete",
    "password_change": "revoke all T07 server sessions",
    "token_in_url": false
  },
  "access": {
    "T07_RLS": true,
    "roles_with_direct_access_to_private_tables": [
      "service_role"
    ],
    "owner_relation": "owner_id → auth.users.id",
    "edge_enforces_owner_on_every_operation": true,
    "unauth_status": 401,
    "other_user_status": 404,
    "T06_legacy_api_status": 410
  },
  "T06_migration": {
    "one_time_claim_code_hash": "SHA-256",
    "transaction": "copy IDs, relationships and actual records into owner_id rows; erase legacy bundle payload and old T06 rows"
  },
  "date_rules": {
    "day_key": "YYYY-MM-DD Asia/Seoul",
    "day_limit": 5,
    "never_pre_fill_future_days": true,
    "rule_change": "after exactly 2 days, before third day",
    "metric": "minutes",
    "missing": "null excluded",
    "duplicates": "one row per owner and date",
    "rounding": "1 decimal average",
    "week_start": "Monday"
  },
